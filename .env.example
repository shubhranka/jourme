# AI keys for scripts/ocr-bakeoff.ts (and later the Supabase Edge Functions). Set either or both.
# Model ids with a slash ("anthropic/claude-sonnet-5.5") use OpenRouter; the rest go straight to Gemini.

# Use a key from a billing-enabled project: on the free tier Google may use submitted content
# to improve its products.
GEMINI_API_KEY=

# Requests are sent with data_collection: "deny", so OpenRouter only routes them to providers
# that don't store or train on prompts.
OPENROUTER_API_KEY=

# Google sign-in for the local Supabase stack (read by `npx supabase start`; see the
# [auth.external.google] block in supabase/config.toml). From a Google Cloud OAuth client of type
# "Web application" with http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
