# The AI coach (supabase/functions/process-entry, via `npx supabase start`) and scripts/ocr-bakeoff.ts.

# Which provider the coach uses: openrouter (default), groq or gemini. Switching this is enough:
# each provider has a free default model. Restart Supabase after changing it.
AI_PROVIDER=openrouter

# OpenRouter. Requests are sent with data_collection: "deny", so OpenRouter only routes them to
# providers that don't store or train on prompts. Default model: dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=

# Groq (free tier: 1000 requests/day, but 8k tokens/minute and at most 3 pages per entry).
# Default model: qwen/qwen3.8-27b. Diary pages are private: turn on Zero Data Retention at
# console.groq.com/settings/data-controls.
GROQ_API_KEY=

# Gemini API. Use a key from a billing-enabled project: on the free tier Google may use submitted
# content to improve its products. Default model: gemini-3.8-flash
GEMINI_API_KEY=

# Optional: override a provider's default model.
# OPENROUTER_MODEL=
# GROQ_MODEL=
# GEMINI_MODEL=

# Google sign-in for the local Supabase stack (read by `npx supabase start`; see the
# [auth.external.google] block in supabase/config.toml). From a Google Cloud OAuth client of type
# "Web application" with http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
